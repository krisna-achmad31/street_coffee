rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Shop images — public read, only authenticated admin can write
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_UID';
    }
  }
}
